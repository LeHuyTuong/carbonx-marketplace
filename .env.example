# Database
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=carbonx
MYSQL_PORT=3307

# Security (minimum 32 bytes random secret; fail-closed in prod)
JWT_SECRET=change-me-to-a-64-char-random-hex-secret-in-production-0123456789
INTERNAL_SERVICE_TOKEN=change-me-internal-s2s-token-at-least-32-bytes-0123456789abcdef

# Google OIDC (identity-service). Leave blank to disable the Google login button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:5173/oauth-success

# Spring AI (OpenAI-compatible: supports Google Gemini, DeepSeek API, OpenAI, or Ollama)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=change-me-gemini-or-deepseek-api-key
AI_MODEL=gemini-2.5-flash

# CORS & Runtime
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
SPRING_PROFILES_ACTIVE=prod

# Observability
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
